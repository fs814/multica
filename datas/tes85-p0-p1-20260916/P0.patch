+    updated_at = now()
+WHERE id = $1 AND workspace_id = $2 AND status = 'draft'
+RETURNING id, workspace_id, template_id, version, definition, schema_version, status, published_by_type, published_by_id, published_at, created_at, updated_at
+`
+
+type UpdateWorkflowTemplateVersionDefinitionParams struct {
+	ID          pgtype.UUID `json:"id"`
+	WorkspaceID pgtype.UUID `json:"workspace_id"`
+	Definition  []byte      `json:"definition"`
+}
+
+// Guarded on status='draft': published definitions are immutable (plan
+// section 4) because in-flight Runs resolve node semantics through them.
+func (q *Queries) UpdateWorkflowTemplateVersionDefinition(ctx context.Context, arg UpdateWorkflowTemplateVersionDefinitionParams) (WorkflowTemplateVersion, error) {
+	row := q.db.QueryRow(ctx, updateWorkflowTemplateVersionDefinition, arg.ID, arg.WorkspaceID, arg.Definition)
+	var i WorkflowTemplateVersion
+	err := row.Scan(
+		&i.ID,
+		&i.WorkspaceID,
+		&i.TemplateID,
+		&i.Version,
+		&i.Definition,
+		&i.SchemaVersion,
+		&i.Status,
+		&i.PublishedByType,
+		&i.PublishedByID,
+		&i.PublishedAt,
+		&i.CreatedAt,
+		&i.UpdatedAt,
+	)
+	return i, err
+}
+
+const workflowEventExists = `-- name: WorkflowEventExists :one
+SELECT EXISTS(
+    SELECT 1 FROM workflow_event
+    WHERE workspace_id = $1 AND idempotency_key = $2
+) AS event_exists
+`
+
+type WorkflowEventExistsParams struct {
+	WorkspaceID    pgtype.UUID `json:"workspace_id"`
+	IdempotencyKey string      `json:"idempotency_key"`
+}
+
+func (q *Queries) WorkflowEventExists(ctx context.Context, arg WorkflowEventExistsParams) (bool, error) {
+	row := q.db.QueryRow(ctx, workflowEventExists, arg.WorkspaceID, arg.IdempotencyKey)
+	var event_exists bool
+	err := row.Scan(&event_exists)
+	return event_exists, err
+}
