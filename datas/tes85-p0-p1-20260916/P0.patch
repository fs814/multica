+// TES-85 only owns objects it creates, never objects whose SQL was skipped.
+// Keep additive schema on application rollback. Destructive rehearsal is opt-in,
+// restricted to empty isolated databases, and requires object provenance.
+const tes85Ownership = "tes85:p0:owned:v1"
+
