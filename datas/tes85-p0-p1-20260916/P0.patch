+// These tests require a real PostgreSQL connection and never substitute a mock.
+func tes85TestDB(t *testing.T) (*pgxpool.Pool, context.Context) {
+	t.Helper()
+	if os.Getenv("TES85_RUN_MIGRATION_TESTS") != "1" {
+		t.Skip("set TES85_RUN_MIGRATION_TESTS=1 for PostgreSQL rehearsal")
+	}
+	ctx := context.Background()
+	config, err := pgxpool.ParseConfig(os.Getenv("DATABASE_URL"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	admin, err := pgxpool.NewWithConfig(ctx, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	schema := fmt.Sprintf("tes85_%d", time.Now().UnixNano())
+	if _, err = admin.Exec(ctx, "CREATE SCHEMA "+pgx.Identifier{schema}.Sanitize()); err != nil {
+		admin.Close()
+		t.Fatal(err)
+	}
+	config.ConnConfig.RuntimeParams["search_path"] = schema + ",public"
+	pool, err := pgxpool.NewWithConfig(ctx, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		pool.Close()
+		_, err := admin.Exec(ctx, "DROP SCHEMA "+pgx.Identifier{schema}.Sanitize()+" CASCADE")
+		if err != nil {
+			t.Error(err)
+		}
+		admin.Close()
+	})
+	for _, name := range []string{"232_workflow_template", "235_workflow_run", "244_workflow_submission_acceptance_event"} {
+		b, err := os.ReadFile(filepath.Join("../../migrations", name+".up.sql"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = pool.Exec(ctx, string(b)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return pool, ctx
+}
+
+func tes85Run(t *testing.T, pool *pgxpool.Pool, ctx context.Context, direction string, names ...string) error {
+	t.Helper()
+	var files []string
+	for _, n := range names {
+		files = append(files, filepath.Join("../../migrations", n+"."+direction+".sql"))
+	}
+	sort.Strings(files)
+	if direction == "down" {
+		sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	}
+	return runMigrations(ctx, pool, runOptions{Direction: direction, Files: files, Hooks: hooksForDirection(direction), Conditions: conditionsForDirection(direction)})
+}
+
+func tes85KeyNames() []string {
+	names := []string{"254_tes85_workflow_run_request_hash"}
+	for _, table := range tes85PrimaryTables {
+		names = append(names, "254_tes85_"+table+"_id_index", "255_tes85_"+table+"_pkey")
+	}
+	return names
+}
+
+func TestTES85PrimaryRehearsal(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	names := tes85KeyNames()
+	if err := tes85Run(t, pool, ctx, "up", names...); err != nil {
+		t.Fatal(err)
+	}
+	for _, table := range tes85PrimaryTables {
+		if ok, err := tes85PrimaryPresent(ctx, pool, table); err != nil || !ok {
+			t.Fatalf("%s: %v %v", table, ok, err)
+		}
+	}
+	if err := tes85Run(t, pool, ctx, "up", names...); err != nil {
+		t.Fatal(err)
+	}
+	if err := tes85Run(t, pool, ctx, "down", names...); err == nil {
+		t.Fatal("default rollback allowed")
+	}
+	t.Setenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK", "1")
+	if err := tes85Run(t, pool, ctx, "down", names...); err != nil {
+		t.Fatal(err)
+	}
+	if err := tes85Run(t, pool, ctx, "up", names...); err != nil {
+		t.Fatal(err)
+	}
+	_, err := pool.Exec(ctx, `INSERT INTO workflow_template(workspace_id,key,name,created_by_type,created_by_id)
+	 VALUES(gen_random_uuid(),'historical','Historical','system',gen_random_uuid())`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := tes85Run(t, pool, ctx, "down", names...); err == nil {
+		t.Fatal("data rollback allowed")
+	}
+}
+
+func TestTES85PreservesExistingOwnership(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	for _, table := range tes85PrimaryTables {
+		if _, err := pool.Exec(ctx, "ALTER TABLE "+table+" ADD CONSTRAINT old_"+table+" PRIMARY KEY(id)"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := pool.Exec(ctx, "ALTER TABLE workflow_run ADD COLUMN request_hash text"); err != nil {
+		t.Fatal(err)
+	}
+	if err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK", "1")
+	for _, name := range tes85KeyNames() {
+		if strings.HasPrefix(name, "255_") || strings.HasSuffix(name, "request_hash") {
+			if err := tes85Run(t, pool, ctx, "down", name); err == nil {
+				t.Fatalf("old object rollback allowed: %s", name)
+			}
+		}
+	}
+	for _, table := range tes85PrimaryTables {
+		var count int
+		if err := pool.QueryRow(ctx, "SELECT count(*) FROM pg_constraint WHERE conrelid=to_regclass($1) AND conname=$2", table, "old_"+table).Scan(&count); err != nil || count != 1 {
+			t.Fatalf("lost old primary %s: %d %v", table, count, err)
+		}
+	}
+}
+
+func TestTES85CrashAndInvalidIndexRecovery(t *testing.T) {
+	for _, scenario := range []string{"index_before_ledger", "attachment_before_ledger", "invalid_index", "wrong_index", "wrong_primary", "nullable_id", "wrong_hash"} {
+		t.Run(scenario, func(t *testing.T) {
+			pool, ctx := tes85TestDB(t)
+			index := "254_tes85_workflow_template_id_index"
+			attach := "255_tes85_workflow_template_pkey"
+			apply := func(name string) {
+				b, err := os.ReadFile(filepath.Join("../../migrations", name+".up.sql"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err = pool.Exec(ctx, string(b)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			exec := func(sql string) {
+				if _, err := pool.Exec(ctx, sql); err != nil {
+					t.Fatal(err)
+				}
+			}
+			switch scenario {
+			case "index_before_ledger":
+				apply(index)
+			case "attachment_before_ledger":
+				apply(index)
+				apply(attach)
+			case "invalid_index":
+				exec(`INSERT INTO workflow_template(id,workspace_id,key,name,created_by_type,created_by_id)
+			 SELECT '00000000-0000-0000-0000-000000000001',gen_random_uuid(),n::text,'Historical','system',gen_random_uuid() FROM generate_series(1,2)n`)
+				if err := tes85Run(t, pool, ctx, "up", index); err == nil {
+					t.Fatal("duplicate IDs accepted")
+				}
+				var valid bool
+				if err := pool.QueryRow(ctx, "SELECT indisvalid FROM pg_index WHERE indexrelid='idx_tes85_workflow_template_id'::regclass").Scan(&valid); err != nil || valid {
+					t.Fatalf("expected actual invalid index: %v %v", valid, err)
+				}
+				exec("DELETE FROM workflow_template WHERE key='2'")
+			case "wrong_index":
+				exec("CREATE UNIQUE INDEX idx_tes85_workflow_template_id ON workflow_template(key)")
+			case "wrong_primary":
+				exec("ALTER TABLE workflow_template ADD PRIMARY KEY(key)")
+			case "nullable_id":
+				exec("ALTER TABLE workflow_template ALTER COLUMN id DROP NOT NULL")
+			case "wrong_hash":
+				exec("ALTER TABLE workflow_run ADD COLUMN request_hash integer")
+			}
+			err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...)
+			bad := strings.HasPrefix(scenario, "wrong_") || scenario == "nullable_id"
+			if bad {
+				if err == nil {
+					t.Fatal("incompatible schema accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, table := range tes85PrimaryTables {
+				if ok, err := tes85PrimaryPresent(ctx, pool, table); err != nil || !ok {
+					t.Fatalf("%s: %v %v", table, ok, err)
+				}
+			}
+		})
+	}
+}
+
+func TestTES85RollbackPreflightPreservesEarlierFiles(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	if err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := pool.Exec(ctx, `CREATE TABLE rollback_sentinel (id int);
+		INSERT INTO rollback_sentinel VALUES(1);
+		INSERT INTO schema_migrations(version) VALUES('999_sentinel')`); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "999_sentinel.down.sql")
+	if err := os.WriteFile(path, []byte("DROP TABLE rollback_sentinel;"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	err := runMigrations(ctx, pool, runOptions{Direction: "down", Files: []string{path,
+		"../../migrations/255_tes85_workflow_template_pkey.down.sql"}, Hooks: preRollbackHooks, Conditions: downMigrationConditions})
+	if err == nil {
+		t.Fatal("rollback was not refused")
+	}
+	var count int
+	if err := pool.QueryRow(ctx, "SELECT count(*) FROM rollback_sentinel").Scan(&count); err != nil || count != 1 {
+		t.Fatalf("earlier down modified state: %d %v", count, err)
+	}
+}
