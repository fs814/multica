+func tes85PrimaryPresent(ctx context.Context, q rowQuerier, table string) (bool, error) {
+	var idOK bool
+	if err := q.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM pg_attribute
+		WHERE attrelid=to_regclass($1) AND attname='id' AND NOT attisdropped
+		AND attnotnull AND atttypid='uuid'::regtype)`, table).Scan(&idOK); err != nil {
+		return false, err
+	}
+	if !idOK {
+		return false, fmt.Errorf("%s requires a NOT NULL uuid id", table)
+	}
+	var found, correct bool
+	err := q.QueryRow(ctx, `SELECT true, c.convalidated AND NOT c.condeferrable
+		AND i.indisvalid AND i.indisready AND i.indisunique AND i.indisprimary
+		AND i.indnkeyatts=1 AND i.indnatts=1 AND i.indexprs IS NULL AND i.indpred IS NULL
+		AND a.attname='id' AND am.amname='btree'
+		FROM pg_constraint c JOIN pg_index i ON i.indexrelid=c.conindid
+		JOIN pg_class x ON x.oid=i.indexrelid JOIN pg_am am ON am.oid=x.relam
+		JOIN pg_attribute a ON a.attrelid=c.conrelid AND a.attnum=c.conkey[1]
+		WHERE c.conrelid=to_regclass($1) AND c.contype='p'`, table).Scan(&found, &correct)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	if !correct {
+		return false, fmt.Errorf("%s has an incompatible primary key", table)
+	}
+	return found, nil
+}
+
+func tes85PrimaryCondition(table string) migrationCondition {
+	return func(ctx context.Context, conn *pgxpool.Conn) (bool, string, error) {
+		present, err := tes85PrimaryPresent(ctx, conn, table)
+		return !present, "equivalent valid primary key already exists; ownership unchanged", err
+	}
+}
+
+func tes85IndexHook(table string) preMigrationHook {
+	return func(ctx context.Context, pool *pgxpool.Pool) error {
+		_, err := tes85PrimaryPresent(ctx, pool, table)
+		if err != nil {
+			return err
+		}
+		name := "idx_tes85_" + table + "_id"
+		var shape, valid, attached bool
+		err = pool.QueryRow(ctx, `SELECT
+			COALESCE(i.indrelid=to_regclass($2) AND i.indisunique AND i.indnkeyatts=1
+			AND i.indnatts=1 AND i.indexprs IS NULL AND i.indpred IS NULL
+			AND a.attname='id' AND am.amname='btree' AND op.opcname='uuid_ops'
+			AND i.indoption[0]=0,false), COALESCE(i.indisvalid AND i.indisready,false),
+			EXISTS(SELECT 1 FROM pg_constraint c WHERE c.conindid=x.oid)
+			FROM pg_class x LEFT JOIN pg_index i ON i.indexrelid=x.oid
+			LEFT JOIN pg_attribute a ON a.attrelid=i.indrelid AND a.attnum=i.indkey[0]
+			LEFT JOIN pg_am am ON am.oid=x.relam LEFT JOIN pg_opclass op ON op.oid=i.indclass[0]
+			WHERE x.oid=to_regclass($1)`, name, table).Scan(&shape, &valid, &attached)
+		if errors.Is(err, pgx.ErrNoRows) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if !shape || attached {
+			return fmt.Errorf("refuse unexpected or attached index %s", name)
+		}
+		if !valid {
+			return cleanupInvalidConcurrentIndexHook(name)(ctx, pool)
+		}
+		return nil
+	}
+}
+
+func tes85HashCondition(ctx context.Context, conn *pgxpool.Conn) (bool, string, error) {
+	var compatible bool
+	err := conn.QueryRow(ctx, `SELECT atttypid='text'::regtype AND NOT attnotnull
+		AND NOT atthasdef FROM pg_attribute WHERE attrelid='workflow_run'::regclass
+		AND attname='request_hash' AND NOT attisdropped`).Scan(&compatible)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return true, "", nil
+	}
+	if err != nil {
+		return false, "", err
+	}
+	if !compatible {
+		return false, "", errors.New("incompatible workflow_run.request_hash; expected nullable text without default")
+	}
+	return false, "existing compatible request_hash retained without taking ownership", nil
+}
+
+func tes85RefuseRollback(context.Context, *pgxpool.Pool) error {
+	return errors.New("TES-85 P0 rollback preserves additive schema; use the previous application or restore an isolated backup")
+}
+
+func tes85EmptyRollback(ctx context.Context, pool *pgxpool.Pool) error {
+	if os.Getenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK") != "1" {
+		return errors.New("TES-85 destructive schema rollback disabled; retain additive schema")
+	}
+	// The override is deliberately unavailable to ordinary deployment databases.
+	var isolated bool
+	if err := pool.QueryRow(ctx, "SELECT current_database() LIKE 'tes85_p0_%'").Scan(&isolated); err != nil {
+		return err
+	}
+	if !isolated {
+		return errors.New("TES-85 destructive rehearsal requires a dedicated tes85_p0_ database")
+	}
+	// Any business data means this is not the permitted empty-database rehearsal.
+	rows, err := pool.Query(ctx, `SELECT tablename FROM pg_tables WHERE schemaname=current_schema()
+		AND tablename<>'schema_migrations'`)
+	if err != nil {
+		return err
+	}
+	var tables []string
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			rows.Close()
+			return err
+		}
+		tables = append(tables, name)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return err
+	}
+	for _, table := range tables {
+		var exists bool
+		if err := pool.QueryRow(ctx, "SELECT EXISTS(SELECT 1 FROM "+pgx.Identifier{table}.Sanitize()+")").Scan(&exists); err != nil {
+			return err
+		}
+		if exists {
+			return fmt.Errorf("TES-85 rollback refused: %s contains data", table)
+		}
+	}
+	return nil
+}
+
+func tes85EmptyPrimaryRollback(table string) preMigrationHook {
+	return func(ctx context.Context, pool *pgxpool.Pool) error {
+		if err := tes85EmptyRollback(ctx, pool); err != nil {
+			return err
+		}
+		present, err := tes85PrimaryPresent(ctx, pool, table)
+		if err != nil {
+			return err
+		}
+		if !present {
+			return errors.New("cannot prove primary key rollback ownership")
+		}
+		var owned bool
+		err = pool.QueryRow(ctx, `SELECT COALESCE(obj_description(oid,'pg_constraint')=$2,false)
+			FROM pg_constraint WHERE conrelid=to_regclass($1) AND contype='p'`, table, tes85Ownership).Scan(&owned)
+		if err != nil {
+			return err
+		}
+		if !owned {
+			return errors.New("primary key predates this batch; refuse rollback")
+		}
+		return nil
+	}
+}
+
+func tes85EmptyHashRollback(ctx context.Context, pool *pgxpool.Pool) error {
+	if err := tes85EmptyRollback(ctx, pool); err != nil {
+		return err
+	}
+	var owned bool
+	err := pool.QueryRow(ctx, `SELECT COALESCE(col_description(attrelid,attnum)=$1,false)
+		FROM pg_attribute WHERE attrelid='workflow_run'::regclass AND attname='request_hash' AND NOT attisdropped`, tes85Ownership).Scan(&owned)
+	if err != nil {
+		return err
+	}
+	if !owned {
+		return errors.New("request_hash predates this batch; refuse rollback")
+	}
+	return nil
+}
+
+func tes85EmptyIndexRollback(table string) preMigrationHook {
+	return func(ctx context.Context, pool *pgxpool.Pool) error {
+		if err := tes85EmptyRollback(ctx, pool); err != nil {
+			return err
+		}
+		var exists bool
+		if err := pool.QueryRow(ctx, "SELECT to_regclass($1) IS NOT NULL", "idx_tes85_"+table+"_id").Scan(&exists); err != nil {
+			return err
+		}
+		if exists {
+			return errors.New("unattached index has no proven ownership; refuse destructive rollback")
+		}
+		// Dropping our owned PK already removed the index; this down is a no-op.
+		return nil
+	}
+}
+
+func tes85MigrationVersion(version string) bool {
+	if strings.HasPrefix(version, "254_tes85_") || strings.HasPrefix(version, "255_tes85_") {
+		return true
+	}
+	switch version {
+	case "232_workflow_template", "233_workflow_template_ws_key_index", "234_workflow_template_version_unique_index",
+		"235_workflow_run", "236_workflow_run_idempotency_index", "237_workflow_run_workspace_created_index",
+		"238_workflow_run_active_index", "239_workflow_run_issue_index", "240_workflow_step_run_node_attempt_index",
+		"241_workflow_step_task_unique_index", "242_workflow_step_run_index", "243_workflow_step_active_index",
+		"244_workflow_submission_acceptance_event", "245_workflow_submission_step_index", "246_workflow_acceptance_pending_index",
+		"247_workflow_event_idempotency_index", "248_workflow_event_run_index", "249_workflow_existing_table_links",
+		"250_agent_task_queue_workflow_step_index", "251_workflow_step_input_node_type", "252_workflow_step_trace_position",
+		"253_workflow_step_trace_position_index", "284_workflow_template_revision":
+		return true
+	}
+	return false
+}
