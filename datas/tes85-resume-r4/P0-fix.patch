diff --git a/server/cmd/migrate/workflow_migration_provenance_test.go b/server/cmd/migrate/workflow_migration_provenance_test.go
new file mode 100644
index 000000000..8b1d31dbe
--- /dev/null
+++ b/server/cmd/migrate/workflow_migration_provenance_test.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"context"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"strings"
+	"testing"
+)
+
+func tes85CatalogState(t *testing.T, ctx context.Context, pool *pgxpool.Pool) string {
+	t.Helper()
+	var state string
+	err := pool.QueryRow(ctx, `SELECT json_build_array(
+ (SELECT json_agg(r ORDER BY r.oid) FROM (SELECT oid,relname,relkind,obj_description(oid,'pg_class') AS comment FROM pg_class WHERE relnamespace=current_schema()::regnamespace) r),
+ (SELECT json_agg(r ORDER BY r.oid) FROM (SELECT oid,conname,conindid,obj_description(oid,'pg_constraint') AS comment FROM pg_constraint WHERE connamespace=current_schema()::regnamespace) r),
+ (SELECT json_agg(r ORDER BY r.version) FROM schema_migrations r))::text`).Scan(&state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return state
+}
+
+func TestTES85PreexistingUniqueIndexesRemainUnowned(t *testing.T) {
+	for _, table := range tes85PrimaryTables {
+		t.Run(table, func(t *testing.T) {
+			pool, ctx := tes85TestDB(t)
+			name := "idx_tes85_" + table + "_id"
+			if _, err := pool.Exec(ctx, "CREATE UNIQUE INDEX "+name+" ON "+table+"(id)"); err != nil {
+				t.Fatal(err)
+			}
+			var oid uint32
+			if err := pool.QueryRow(ctx, "SELECT to_regclass($1)::oid", name).Scan(&oid); err != nil {
+				t.Fatal(err)
+			}
+			if err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...); err != nil {
+				t.Fatal(err)
+			}
+			var preserved bool
+			if err := pool.QueryRow(ctx, `SELECT conindid=$2 AND obj_description(oid,'pg_constraint') IS NULL FROM pg_constraint WHERE conrelid=to_regclass($1) AND contype='p'`, table, oid).Scan(&preserved); err != nil || !preserved {
+				t.Fatalf("adopted existing index: %v %v", preserved, err)
+			}
+			before := tes85CatalogState(t, ctx, pool)
+			t.Setenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK", "1")
+			if err := tes85Run(t, pool, ctx, "down", tes85KeyNames()...); err == nil {
+				t.Fatal("unowned rollback accepted")
+			}
+			if after := tes85CatalogState(t, ctx, pool); after != before {
+				t.Fatal("refusal changed catalog or ledger")
+			}
+		})
+	}
+}
+
+func TestTES85UnknownInvalidIndexPreserved(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	if _, err := pool.Exec(ctx, `INSERT INTO workflow_template(id,workspace_id,key,name,created_by_type,created_by_id)
+ SELECT '00000000-0000-0000-0000-000000000001',gen_random_uuid(),n::text,'Historical','system',gen_random_uuid() FROM generate_series(1,2)n`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := pool.Exec(ctx, "CREATE UNIQUE INDEX CONCURRENTLY idx_tes85_workflow_template_id ON workflow_template(id)"); err == nil {
+		t.Fatal("expected duplicate failure")
+	}
+	var oid uint32
+	if err := pool.QueryRow(ctx, "SELECT 'idx_tes85_workflow_template_id'::regclass::oid").Scan(&oid); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := pool.Exec(ctx, "DELETE FROM workflow_template WHERE key='2'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...); err == nil {
+		t.Fatal("unknown invalid index removed")
+	}
+	var preserved bool
+	if err := pool.QueryRow(ctx, "SELECT EXISTS(SELECT 1 FROM pg_class WHERE oid=$1 AND obj_description(oid,'pg_class') IS NULL)", oid).Scan(&preserved); err != nil || !preserved {
+		t.Fatalf("lost unowned invalid index: %v %v", preserved, err)
+	}
+}
+
+func TestTES85IndexProvenanceSurvivesLedgerRetry(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	names := tes85KeyNames()
+	if err := tes85Run(t, pool, ctx, "up", names...); err != nil {
+		t.Fatal(err)
+	}
+	// Simulate losing only the ledger write after the committed DDL/comment.
+	if _, err := pool.Exec(ctx, "DELETE FROM schema_migrations WHERE version LIKE '25%'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := tes85Run(t, pool, ctx, "up", names...); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK", "1")
+	if err := tes85Run(t, pool, ctx, "down", names...); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestTES85LegacyClaimDoesNotProveIndexOwnership(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	if err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := pool.Exec(ctx, `COMMENT ON CONSTRAINT workflow_template_pkey ON workflow_template IS 'tes85:p0:owned:v1'; COMMENT ON INDEX workflow_template_pkey IS NULL`); err != nil {
+		t.Fatal(err)
+	}
+	before := tes85CatalogState(t, ctx, pool)
+	t.Setenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK", "1")
+	if err := tes85Run(t, pool, ctx, "down", tes85KeyNames()...); err == nil {
+		t.Fatal("legacy claim accepted")
+	}
+	if tes85CatalogState(t, ctx, pool) != before {
+		t.Fatal("legacy refusal changed catalog/ledger")
+	}
+}
+
+// Run on both the literal dedicated prefix and lookalike database names.
+func TestTES85DatabasePrefixBoundary(t *testing.T) {
+	pool, ctx := tes85TestDB(t)
+	if err := tes85Run(t, pool, ctx, "up", tes85KeyNames()...); err != nil {
+		t.Fatal(err)
+	}
+	var name string
+	if err := pool.QueryRow(ctx, "SELECT current_database()").Scan(&name); err != nil {
+		t.Fatal(err)
+	}
+	before := tes85CatalogState(t, ctx, pool)
+	t.Setenv("TES85_ALLOW_EMPTY_SCHEMA_ROLLBACK", "1")
+	err := tes85Run(t, pool, ctx, "down", tes85KeyNames()...)
+	if strings.HasPrefix(name, "tes85_p0_") {
+		if err != nil {
+			t.Fatal(err)
+		}
+	} else {
+		if err == nil {
+			t.Fatal("lookalike database accepted")
+		}
+		if tes85CatalogState(t, ctx, pool) != before {
+			t.Fatal("prefix refusal changed catalog/ledger")
+		}
+	}
+}
