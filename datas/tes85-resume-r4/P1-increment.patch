+// The migration advisory lock serializes runners. Only a successful CREATE (or
+// its own unique-violation artifact) proves provenance; a name or ledger does not.
+// A crash before COMMENT leaves an unowned object: valid indexes can be reused,
+// but invalid ones require operator inspection and destructive down is refused.
+func tes85CreateIndex(ctx context.Context, conn *pgxpool.Conn, name, sql string) error {
+	var exists bool
+	if err := conn.QueryRow(ctx, "SELECT to_regclass($1) IS NOT NULL", name).Scan(&exists); err != nil {
+		return err
+	}
+	if exists {
+		return nil // Shape-checked by the pre-migration hook; never claim it.
+	}
+	// Do not silently adopt an index created by concurrent external DDL.
+	_, createErr := conn.Exec(ctx, strings.Replace(sql, "IF NOT EXISTS ", "", 1))
+	var pgErr *pgconn.PgError
+	if createErr != nil && !(errors.As(createErr, &pgErr) && pgErr.Code == "23505") {
+		return createErr
+	}
+	_, markErr := conn.Exec(ctx, "COMMENT ON INDEX "+pgx.Identifier{name}.Sanitize()+" IS '"+tes85IndexOwnership+"'")
+	return errors.Join(createErr, markErr)
+}
 
