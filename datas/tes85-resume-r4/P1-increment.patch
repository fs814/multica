+		if err := testPool.QueryRow(context.Background(), "SELECT count(*) FROM "+table).Scan(&counts[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return counts
+}
diff --git a/server/internal/service/agent_invoke.go b/server/internal/service/agent_invoke.go
new file mode 100644
index 000000000..c9aa967f4
--- /dev/null
+++ b/server/internal/service/agent_invoke.go
@@ -0,0 +1,159 @@
+package service
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/util"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+// The agent invocation-permission rule (MUL-3963), extracted so there is exactly
+// ONE implementation of it.
+//
+// It previously lived only as handler.canInvokeAgent, a *Handler method. The
+// workflow router runs in package service and cannot call a handler method, and
+// the alternative - re-deriving "who may trigger this agent" against the same
+// tables - would create a second copy of the most security-sensitive predicate
+// in the codebase. Two copies of an authorization rule do not stay equal: one
+// gets a fix, the other keeps the hole, and the divergence only surfaces when a
+// user triggers the same agent through two different entry points. So the rule
+// moved here and handler.canInvokeAgent now delegates.
+//
+// This is a MOVE, not a reinterpretation. The semantics below are the ones
+// canInvokeAgent enforced, unchanged:
+//
+//   - The agent OWNER may always invoke their own agent.
+//   - permission_mode != "public_to" (i.e. private, or any unknown mode) is
+//     deny-by-default: NO workspace-admin bypass and NO agent-to-agent bypass.
+//     An admin must not be able to spend someone else's Composio/OAuth
+//     connections just because they administer the workspace.
+//   - permission_mode == "public_to" consults the agent_invocation_target
+//     allow-list: a `workspace` target admits any workspace member, a `member`
+//     target admits only that user, and `team` targets are reserved and inert.
+//   - Agent and system principals are workspace-internal and a `workspace`
+//     target admits them even with no resolved human. That exception is scoped
+//     tightly to the workspace target: member/team targets still require a
+//     matching human, so an unattributed trigger fails closed against a
+//     specific-people grant and cannot smuggle itself onto it.
+//   - A2A is judged by the top-of-chain human ORIGINATOR, never the immediate
+//     agent actor, so agents cannot chain into a channel that bypasses an
+//     owner's allow-list.
+//   - Target-list lookup errors deny non-owners. Membership lookup errors only
+//     clear membership; exact member targets and internal workspace actors retain
+//     the established exceptions. Tenant/readiness checks belong to callers.
+
+// InvokeActor identifies who is asking to trigger an agent.
+//
+// ActorID is the immediate principal; OriginatorUserID is the top-of-chain human
+// the action is attributed to. For a member actor they are the same person. For
+// an agent or system actor only OriginatorUserID is trusted - an empty value
+// means no human could be attributed, which fails closed everywhere except the
+// workspace-target exception above.
+type InvokeActor struct {
+	// ActorType is "member", "agent", or "system".
+	ActorType string
+	// ActorID is the member user id, or the agent id for an agent actor.
+	ActorID string
+	// OriginatorUserID is the resolved top-of-chain human, or "" when none.
+	OriginatorUserID string
+	// WorkspaceID scopes the workspace-membership check.
+	WorkspaceID string
+}
+
+// MemberInvokeActor builds the actor for a plain human-initiated invocation,
+// where the member is their own originator. Used by the workflow router, whose
+// invoking principal is the Run's accountable human.
+func MemberInvokeActor(userID, workspaceID string) InvokeActor {
+	return InvokeActor{
+		ActorType:        "member",
+		ActorID:          userID,
+		OriginatorUserID: userID,
+		WorkspaceID:      workspaceID,
+	}
+}
+
+// SystemInvokeActor builds the actor for an approved source with no attributable
+// human in the chain. It is NOT a bypass: it fails closed for private agents
+// and for member/team-scoped allow-lists, and only satisfies a `public_to
+// workspace` target. Autopilot must still resolve its triggering member and
+// reject failed resolution before starting a run.
+func SystemInvokeActor(workspaceID string) InvokeActor {
+	return InvokeActor{ActorType: "system", WorkspaceID: workspaceID}
+}
+
+// AgentInvokePermitted reports whether actor may trigger a run for agent.
+//
+// q is taken as a parameter (rather than read off a service struct) so the
+// caller's transaction-scoped *db.Queries is used when there is one: the
+// workflow router runs inside the Step-activation transaction, and reading
+// permission on a different connection could see an allow-list the surrounding
+// transaction has not observed.
+func AgentInvokePermitted(ctx context.Context, q *db.Queries, agent db.Agent, actor InvokeActor) bool {
+	effectiveUser := actor.ActorID
+	if actor.ActorType != "member" {
+		// agent / system: never trust the immediate principal, only the resolved
+		// human originator at the top of the chain.
+		effectiveUser = actor.OriginatorUserID
+	}
+
+	if effectiveUser != "" && util.UUIDToString(agent.OwnerID) == effectiveUser {
+		return true
+	}
+
+	if agent.PermissionMode != "public_to" {
+		return false
+	}
+
+	targets, err := q.ListAgentInvocationTargets(ctx, agent.ID)
+	if err != nil {
+		return false
+	}
+
+	workspaceBroad := actor.ActorType == "agent" || actor.ActorType == "system"
+	isWorkspaceMember := false
+	if effectiveUser != "" {
+		userUUID, uerr := util.ParseUUID(effectiveUser)
+		wsUUID, werr := util.ParseUUID(actor.WorkspaceID)
+		if uerr == nil && werr == nil {
+			if _, err := q.GetMemberByUserAndWorkspace(ctx, db.GetMemberByUserAndWorkspaceParams{
+				UserID:      userUUID,
+				WorkspaceID: wsUUID,
+			}); err == nil {
+				isWorkspaceMember = true
+			}
+		}
+	}
+
+	for _, t := range targets {
+		switch t.TargetType {
+		case "workspace":
+			if isWorkspaceMember || workspaceBroad {
+				return true
+			}
+		case "member":
+			// Requires a resolved human. An agent/system trigger with no
+			// originator never matches here - fail closed.
+			if effectiveUser != "" && util.UUIDToString(t.TargetID) == effectiveUser {
+				return true
+			}
+		case "team":
+			// Reserved: team membership does not exist in V1, so team targets
+			// admit nobody (also fail-closed for system/agent).
+		}
+	}
+	return false
+}
+
+// invokeActorForRun resolves the invoking principal for a workflow Run.
+//
+// A Run with an accountable human is judged as that member. Only an approved
+// source with no attributable human may be judged as system. Autopilot entry
+// points must resolve the clicking/triggering member and reject failed resolution.
+func invokeActorForRun(workspaceID, accountableUserID pgtype.UUID) InvokeActor {
+	ws := util.UUIDToString(workspaceID)
+	if accountableUserID.Valid {
+		return MemberInvokeActor(util.UUIDToString(accountableUserID), ws)
+	}
+	return SystemInvokeActor(ws)
+}
diff --git a/server/internal/service/agent_invoke_test.go b/server/internal/service/agent_invoke_test.go
new file mode 100644
index 000000000..d2a40b652
--- /dev/null
+++ b/server/internal/service/agent_invoke_test.go
@@ -0,0 +1,152 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/multica-ai/multica/server/internal/testutil"
+	"github.com/multica-ai/multica/server/internal/util"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+	"strings"
+	"testing"
+	"time"
+)
+
+type invokeFaultDB struct {
+	*pgxpool.Pool
+	memberFailure, targetsFailure bool
+}
+type invokeFaultRow struct{}
+
+func (invokeFaultRow) Scan(...any) error { return errors.New("injected membership read failure") }
+func (d invokeFaultDB) QueryRow(ctx context.Context, sql string, args ...any) pgx.Row {
+	if d.memberFailure && strings.Contains(sql, "GetMemberByUserAndWorkspace") {
+		return invokeFaultRow{}
+	}
+	return d.Pool.QueryRow(ctx, sql, args...)
+}
+func (d invokeFaultDB) Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error) {
+	if d.targetsFailure && strings.Contains(sql, "ListAgentInvocationTargets") {
+		return nil, errors.New("injected target read failure")
+	}
+	return d.Pool.Query(ctx, sql, args...)
+}
+
+func TestAgentInvokePermissionMatrix(t *testing.T) {
+	ctx := context.Background()
+	pool := sharedTestPool(t)
+	fx := testutil.New(pool, "", "")
+	suffix := fmt.Sprint(time.Now().UnixNano())
+	owner := fx.User(t, "Owner", "owner-"+suffix+"@example.invalid")
+	member := fx.User(t, "Member", "member-"+suffix+"@example.invalid")
+	stranger := fx.User(t, "Stranger", "stranger-"+suffix+"@example.invalid")
+	ws := fx.Workspace(t, "Invoke matrix", "invoke-"+suffix)
+	fx.WorkspaceID = ws
+	fx.UserID = owner
+	fx.Member(t, ws, owner, "owner")
+	fx.Member(t, ws, member, "admin")
+	agentID := fx.Agent(t, "Matrix agent", "", testutil.Cols{"permission_mode": "public_to"})
+	q := db.New(pool)
+	agent, err := q.GetAgent(ctx, util.MustParseUUID(agentID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	fx.Cleanup(t, "DELETE FROM agent_invocation_target WHERE agent_id=$1", agentID)
+	actor := func(kind, id, origin string) InvokeActor {
+		return InvokeActor{ActorType: kind, ActorID: id, OriginatorUserID: origin, WorkspaceID: ws}
+	}
+	cases := []struct {
+		name, mode, target, targetID string
+		who                          InvokeActor
+		memberErr, targetErr, want   bool
+	}{
+		{"owner private", "private", "", "", actor("member", owner, ""), false, false, true},
+		{"owner unknown", "unknown", "", "", actor("member", owner, ""), false, false, true},
+		{"owner ignores lookup failures", "public_to", "", "", actor("member", owner, ""), true, true, true},
+		{"admin private denied", "private", "", "", actor("member", member, ""), false, false, false},
+		{"admin unknown denied", "unknown", "", "", actor("member", member, ""), false, false, false},
+		{"workspace member", "public_to", "workspace", ws, actor("member", member, ""), false, false, true},
+		{"workspace stranger", "public_to", "workspace", ws, actor("member", stranger, ""), false, false, false},
+		{"workspace malformed", "public_to", "workspace", ws, actor("member", "invalid", ""), false, false, false},
+		{"workspace membership error", "public_to", "workspace", ws, actor("member", member, ""), true, false, false},
+		{"exact member", "public_to", "member", member, actor("member", member, ""), false, false, true},
+		{"exact member lookup error exception", "public_to", "member", member, actor("member", member, ""), true, false, true},
+		{"member mismatch", "public_to", "member", owner, actor("member", member, ""), false, false, false},
+		{"team inert", "public_to", "team", member, actor("member", member, ""), false, false, false},
+		{"empty targets", "public_to", "", "", actor("member", member, ""), false, false, false},
+		{"targets error", "public_to", "workspace", ws, actor("member", member, ""), false, true, false},
+		{"member ignores originator", "private", "", "", actor("member", member, owner), false, false, false},
+		{"agent owner originator", "private", "", "", actor("agent", stranger, owner), false, false, true},
+		{"agent actor owner insufficient", "private", "", "", actor("agent", owner, member), false, false, false},
+		{"agent member originator", "public_to", "member", member, actor("agent", stranger, member), false, false, true},
+		{"system originator owner", "private", "", "", actor("system", "", owner), false, false, true},
+		{"system workspace exception", "public_to", "workspace", ws, actor("system", "", ""), true, false, true},
+		{"agent workspace exception", "public_to", "workspace", ws, actor("agent", stranger, ""), true, false, true},
+		{"invalid actor no workspace exception", "public_to", "workspace", ws, actor("invalid", "", ""), false, false, false},
+		{"system private", "private", "", "", actor("system", "", ""), false, false, false},
+		{"system member only", "public_to", "member", member, actor("system", "", ""), false, false, false},
+		{"system team only", "public_to", "team", member, actor("system", "", ""), false, false, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			fx.Exec(t, "DELETE FROM agent_invocation_target WHERE agent_id=$1", agentID)
+			if c.target != "" {
+				fx.Exec(t, "INSERT INTO agent_invocation_target(agent_id,target_type,target_id) VALUES($1,$2,$3)", agentID, c.target, c.targetID)
+			}
+			a := agent
+			a.PermissionMode = c.mode
+			queries := db.New(invokeFaultDB{Pool: pool, memberFailure: c.memberErr, targetsFailure: c.targetErr})
+			if got := AgentInvokePermitted(ctx, queries, a, c.who); got != c.want {
+				t.Fatalf("allowed=%v want=%v", got, c.want)
+			}
+			// This is the unchanged independent Autopilot member predicate, not delegation.
+			if c.who.ActorType == "member" && !c.memberErr && !c.targetErr && c.who.ActorID != "invalid" {
+				svc := &AutopilotService{Queries: q}
+				if got := svc.canMemberInvokeAgent(ctx, a, util.MustParseUUID(c.who.ActorID), util.MustParseUUID(ws)); got != c.want {
+					t.Fatalf("autopilot member parity=%v want=%v", got, c.want)
+				}
+			}
+		})
+	}
+	memberActor := invokeActorForRun(util.MustParseUUID(ws), util.MustParseUUID(member))
+	if memberActor != MemberInvokeActor(member, ws) {
+		t.Fatal("accountable mapping changed")
+	}
+	if invokeActorForRun(util.MustParseUUID(ws), pgtype.UUID{}) != SystemInvokeActor(ws) {
+		t.Fatal("unattributed mapping changed")
+	}
+}
+
+func TestAgentInvokeTransactionReads(t *testing.T) {
+	ctx := context.Background()
+	env := newWorkflowRouterEnv(t)
+	id := env.createAgent(t, agentSpec{name: "Transactional permission", owner: env.otherUserID})
+	agent, err := env.q.GetAgent(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	actor := MemberInvokeActor(util.UUIDToString(env.userID), util.UUIDToString(env.workspaceID))
+	tx, err := env.pool.Begin(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback(ctx)
+	if _, err = tx.Exec(ctx, "DELETE FROM agent_invocation_target WHERE agent_id=$1", id); err != nil {
+		t.Fatal(err)
+	}
+	if AgentInvokePermitted(ctx, env.q.WithTx(tx), agent, actor) {
+		t.Fatal("transaction ignored revocation")
+	}
+	if !AgentInvokePermitted(ctx, env.q, agent, actor) {
+		t.Fatal("pool unexpectedly saw uncommitted revoke")
+	}
+	if err = tx.Rollback(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if !AgentInvokePermitted(ctx, env.q, agent, actor) {
+		t.Fatal("rollback did not restore allow-list")
+	}
+}
