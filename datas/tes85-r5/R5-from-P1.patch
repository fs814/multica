+const listCancelledWorkflowRunsWithActiveTasks = `-- name: ListCancelledWorkflowRunsWithActiveTasks :many
+SELECT DISTINCT r.id, r.workspace_id
+FROM workflow_run r
+JOIN workflow_step_instance s ON s.run_id = r.id AND s.workspace_id = r.workspace_id
+JOIN agent_task_queue t ON t.workflow_step_instance_id = s.id
