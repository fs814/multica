+ORDER BY r.id
+LIMIT $1::int
+`
+
+type ListCancelledWorkflowRunsWithActiveTasksRow struct {
+	ID          pgtype.UUID `json:"id"`
+	WorkspaceID pgtype.UUID `json:"workspace_id"`
+}
+
+// Persisted intent survives commit/stop failures. Scope the task through its step.
+func (q *Queries) ListCancelledWorkflowRunsWithActiveTasks(ctx context.Context, limitCount int32) ([]ListCancelledWorkflowRunsWithActiveTasksRow, error) {
+	rows, err := q.db.Query(ctx, listCancelledWorkflowRunsWithActiveTasks, limitCount)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []ListCancelledWorkflowRunsWithActiveTasksRow{}
+	for rows.Next() {
+		var i ListCancelledWorkflowRunsWithActiveTasksRow
+		if err := rows.Scan(&i.ID, &i.WorkspaceID); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
