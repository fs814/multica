+// Run cancellation cascades to every non-terminal Step in application code
+// (no DB cascades, plan section 4).
+func (q *Queries) CancelWorkflowStepInstancesForRun(ctx context.Context, arg CancelWorkflowStepInstancesForRunParams) ([]WorkflowStepInstance, error) {
