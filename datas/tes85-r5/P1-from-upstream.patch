+const summarizeWorkflowStepsForRuns = `-- name: SummarizeWorkflowStepsForRuns :many
+SELECT s.run_id,
+       count(*)::bigint AS step_count,
+       (SELECT c.node_key
+        FROM workflow_step_instance c
+        WHERE c.run_id = s.run_id AND c.workspace_id = s.workspace_id
+        ORDER BY (c.status IN ('pending', 'ready', 'queued', 'running', 'submitted', 'waiting_acceptance')) DESC,
+                 c.created_at DESC
+        LIMIT 1) AS current_node_key
+FROM workflow_step_instance s
+WHERE s.workspace_id = $1::uuid
+  AND s.run_id = ANY($2::uuid[])
+GROUP BY s.run_id, s.workspace_id
+`
+
+type SummarizeWorkflowStepsForRunsParams struct {
+	WorkspaceID pgtype.UUID   `json:"workspace_id"`
+	RunIds      []pgtype.UUID `json:"run_ids"`
+}
+
+type SummarizeWorkflowStepsForRunsRow struct {
+	RunID          pgtype.UUID `json:"run_id"`
+	StepCount      int64       `json:"step_count"`
+	CurrentNodeKey string      `json:"current_node_key"`
+}
+
+// step_count + current_node_key per run, batched over a page of runs.
+//
+// Batched for the same reason ListWorkflowTemplatesByIDs is: this feeds the runs
+// list, and a per-run query would make a 20-row page 20 extra round trips to
+// render two columns. The DETAIL endpoint calls it too - with a single-element
+// run_ids - even though it already holds every Step row, so that "which node is
+// this run on" has exactly ONE definition. Recomputing it in Go for detail would
+// let the list and the detail page disagree about the same run, which is the kind
+// of drift a reader blames on the run rather than on the API.
+//
+// current_node_key prefers a non-terminal Step and then the newest, which is what
+// keeps the answer stable through rework: the same node key has several attempts
+// and only the latest is what a reader means by "where is this run". It falls
+// back to the newest terminal Step so a finished, failed, or blocked Run still
+// reports the node it ended on - precisely when a human most needs to know where
+// it stopped.
+//
+// Runs with no Steps are absent from the result, so callers must default them to
+// step_count 0 / no current node: a Run that blocked at routing before its first
+// activation legitimately has none.
+func (q *Queries) SummarizeWorkflowStepsForRuns(ctx context.Context, arg SummarizeWorkflowStepsForRunsParams) ([]SummarizeWorkflowStepsForRunsRow, error) {
+	rows, err := q.db.Query(ctx, summarizeWorkflowStepsForRuns, arg.WorkspaceID, arg.RunIds)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []SummarizeWorkflowStepsForRunsRow{}
+	for rows.Next() {
+		var i SummarizeWorkflowStepsForRunsRow
+		if err := rows.Scan(&i.RunID, &i.StepCount, &i.CurrentNodeKey); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
+
+const updateWorkflowTemplate = `-- name: UpdateWorkflowTemplate :one
+UPDATE workflow_template SET
+    name = COALESCE($3, name),
+    description = COALESCE($4, description),
+    revision = revision + 1,
+    updated_at = now()
+WHERE id = $1 AND workspace_id = $2
+  AND revision = $5::bigint
+RETURNING id, workspace_id, key, name, description, status, current_version, created_by_type, created_by_id, archived_at, created_at, updated_at, revision
+`
+
+type UpdateWorkflowTemplateParams struct {
+	ID               pgtype.UUID `json:"id"`
+	WorkspaceID      pgtype.UUID `json:"workspace_id"`
+	Name             pgtype.Text `json:"name"`
+	Description      pgtype.Text `json:"description"`
+	ExpectedRevision int64       `json:"expected_revision"`
+}
+
+// `key` is immutable: external callers and autopilots reference it, so a
+// rename would silently break their intake requests.
+func (q *Queries) UpdateWorkflowTemplate(ctx context.Context, arg UpdateWorkflowTemplateParams) (WorkflowTemplate, error) {
+	row := q.db.QueryRow(ctx, updateWorkflowTemplate,
+		arg.ID,
+		arg.WorkspaceID,
+		arg.Name,
+		arg.Description,
+		arg.ExpectedRevision,
+	)
+	var i WorkflowTemplate
+	err := row.Scan(
+		&i.ID,
+		&i.WorkspaceID,
+		&i.Key,
+		&i.Name,
+		&i.Description,
+		&i.Status,
+		&i.CurrentVersion,
+		&i.CreatedByType,
+		&i.CreatedByID,
+		&i.ArchivedAt,
+		&i.CreatedAt,
+		&i.UpdatedAt,
+		&i.Revision,
+	)
+	return i, err
+}
+
+const updateWorkflowTemplateVersionDefinition = `-- name: UpdateWorkflowTemplateVersionDefinition :one
+UPDATE workflow_template_version SET
+    definition = $3::jsonb,
+    schema_version = COALESCE(($3::jsonb->>'schema_version')::int, 1),
+    updated_at = now()
+WHERE id = $1 AND workspace_id = $2 AND status = 'draft'
+RETURNING id, workspace_id, template_id, version, definition, schema_version, status, published_by_type, published_by_id, published_at, created_at, updated_at
+`
+
+type UpdateWorkflowTemplateVersionDefinitionParams struct {
+	ID          pgtype.UUID `json:"id"`
+	WorkspaceID pgtype.UUID `json:"workspace_id"`
+	Definition  []byte      `json:"definition"`
+}
+
+// Guarded on status='draft': published definitions are immutable (plan
+// section 4) because in-flight Runs resolve node semantics through them.
+func (q *Queries) UpdateWorkflowTemplateVersionDefinition(ctx context.Context, arg UpdateWorkflowTemplateVersionDefinitionParams) (WorkflowTemplateVersion, error) {
+	row := q.db.QueryRow(ctx, updateWorkflowTemplateVersionDefinition, arg.ID, arg.WorkspaceID, arg.Definition)
+	var i WorkflowTemplateVersion
+	err := row.Scan(
+		&i.ID,
+		&i.WorkspaceID,
+		&i.TemplateID,
+		&i.Version,
+		&i.Definition,
+		&i.SchemaVersion,
+		&i.Status,
+		&i.PublishedByType,
+		&i.PublishedByID,
+		&i.PublishedAt,
+		&i.CreatedAt,
+		&i.UpdatedAt,
+	)
+	return i, err
+}
+
+const workflowEventExists = `-- name: WorkflowEventExists :one
+SELECT EXISTS(
+    SELECT 1 FROM workflow_event
+    WHERE workspace_id = $1 AND idempotency_key = $2
+) AS event_exists
+`
+
+type WorkflowEventExistsParams struct {
+	WorkspaceID    pgtype.UUID `json:"workspace_id"`
+	IdempotencyKey string      `json:"idempotency_key"`
+}
+
+func (q *Queries) WorkflowEventExists(ctx context.Context, arg WorkflowEventExistsParams) (bool, error) {
+	row := q.db.QueryRow(ctx, workflowEventExists, arg.WorkspaceID, arg.IdempotencyKey)
+	var event_exists bool
+	err := row.Scan(&event_exists)
+	return event_exists, err
+}
