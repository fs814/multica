+func (h *Handler) resolveAutopilotWorkflowBinding(ctx context.Context, workspaceID pgtype.UUID, templateRaw, versionRaw *string) (pgtype.UUID, pgtype.UUID, error) {
+	if templateRaw == nil || strings.TrimSpace(*templateRaw) == "" {
