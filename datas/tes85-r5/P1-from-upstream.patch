+		WorkspaceID: env.workspaceID,
+	})
+	if err != nil {
+		t.Fatalf("list steps: %v", err)
+	}
+	// Highest attempt wins, so rework tests see the newest attempt.
+	var found db.WorkflowStepInstance
+	for _, s := range steps {
