+		req := newRequest("PUT", "/api/issues/"+*detail.IssueID, map[string]any{"status": "cancelled"}).WithContext(ctx)
+		testHandler.UpdateIssue(rec, withURLParam(req, "id", *detail.IssueID))
+		response <- rec
