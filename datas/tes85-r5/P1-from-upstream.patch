+func TestReconcileRunRepairsRunningRunWithNoActiveStep(t *testing.T) {
+	env := setupTestEnv(t)
+	env.publishTemplate(t, linearDefinition())
+	run := env.startRun(t, "reconcile-no-active")
+	step := env.stepByNode(t, run.ID, "analyze")
