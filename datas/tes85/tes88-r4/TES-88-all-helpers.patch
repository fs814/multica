+  with self.assertRaises(ValueError):prepare(self.c,self.t)
+ def test_missing_identity_rejected(self):
+  self.c['machines']['book']['agent_id']=''
+  with self.assertRaises(ValueError):prepare(self.c,self.t)
+if __name__=='__main__':unittest.main()
